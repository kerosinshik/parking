# Скопировать в /srv/parking/.env и заполнить. Файл не коммитить.
PARKAN_BOT_TOKEN=123456:ABC...           # токен бота-дорвея от @BotFather (отдельный бот, не тот, что пишет в кухню)
PARKAN_CHANNEL_URL=https://t.me/poputny_metr
PARKAN_BOT_ADMINS=                       # ваш числовой id в Telegram (узнать у @userinfobot): /stats
PARKAN_BOT_LOTS=/srv/parking-data/channel_state/bot/lots.json
PARKAN_BOT_DB=/var/lib/poputny-bot/bot.sqlite
# PARKAN_BOT_GATE=0                      # открыть всё без подписки на канал
# PARKAN_CHANNEL_CHAT=@poputny_metr      # если канал задан не ссылкой t.me
